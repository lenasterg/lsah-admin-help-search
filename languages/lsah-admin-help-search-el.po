#. Plugin Name of the plugin
#: lsah-admin-help-search.php
msgid "LSAH Admin Help Search"
msgstr "LSAH Admin Help Search"

#. Description of the plugin
#: lsah-admin-help-search.php
msgid ""
"Adds a search field within the WordPress dashboard for instant access to "
"user manuals and logs queries to help administrators improve documentation. "
"Fully multisite compatible."
msgstr ""
"Προσθέτει ένα πεδίο αναζήτησης στον πίνακα ελέγχου του WordPress για άμεση "
"πρόσβαση σε εγχειρίδια χρήστη και καταγράφει ερωτήματα για να βοηθήσει τους "
"διαχειριστές να βελτιώσουν την τεκμηρίωση. Πλήρως συμβατό με multisite."

#. Author of the plugin
#: lsah-admin-help-search.php
msgid "lenasterg"
msgstr "lenasterg"

#. Author URI of the plugin
#: lsah-admin-help-search.php
msgid "https://lenasterg.wordpress.com"
msgstr "https://lenasterg.wordpress.com"

#: lsah-admin-help-search.php:101
msgid "Settings"
msgstr "Ρυθμίσεις"

#: lsah-admin-help-search.php:102
msgid "Statistics"
msgstr "Στατιστικά αναζήτησης βοήθειας"

#. translators: %s: Settings page URL
#: lsah-admin-help-search.php:160
msgid "Settings → Help Search"
msgstr "Ρυθμίσεις → Αναζήτηση Bοήθειας"

#. translators: %1$s: message text, %2$s: link
#: lsah-admin-help-search.php:163
msgid "LSAH: Please configure the Help Search Action URL in %1$s."
msgstr ""
"LSAH: Παρακαλούμε ρυθμίστε το Action URL της Αναζήτησης Βοήθειας στις %1$s."

#: lsah-admin-help-search.php:207 lsah-admin-help-search.php:421
#: lsah-admin-help-search.php:443
msgid "Help Search"
msgstr "Αναζήτηση Βοήθειας"

#: lsah-admin-help-search.php:208 lsah-admin-help-search.php:253
msgid "Help for..."
msgstr "Βοήθεια για …"

#: lsah-admin-help-search.php:254
msgid "Search the help manual"
msgstr "Αναζήτηση στο εγχειρίδιο χρήσης"

#: lsah-admin-help-search.php:255
msgid "Help Search URL not configured."
msgstr "Το URL του συνδέσμου αναζήτησης βοήθειας δεν έχει οριστεί."

#: lsah-admin-help-search.php:258
msgid "New: Help Search"
msgstr "Νέο: Αναζήτηση Βοήθειας"

#: lsah-admin-help-search.php:259
msgid "Search our documentation directly from here!"
msgstr "Αναζητήστε στην τεκμηρίωσή μας απευθείας από εδώ!"

#: lsah-admin-help-search.php:260
msgid ""
"If this bothers you, you can hide this search box from the \"Screen "
"Options\" tab, (in the top right of the screen)."
msgstr ""
"Mπορείτε να αποκρύψετε αυτό το πλαίσιο αναζήτησης από την καρτέλα "
"\"Επιλογές προβολής\" (στην επάνω δεξιά γωνία της οθόνης), σε περίπτωση που "
"σας ενοχλεί."

#: lsah-admin-help-search.php:261
msgid ""
"There, you can also choose if help should open in a new tab or at the right "
"of the screen."
msgstr ""
"Εκεί, μπορείτε επίσης να επιλέξετε αν η βοήθεια θα ανοίγει σε νέα καρτέλα ή "
"στα δεξιά της οθόνης."

#: lsah-admin-help-search.php:420 lsah-admin-help-search.php:442
#: lsah-admin-help-search.php:501
msgid "Help Search Settings"
msgstr "Ρυθμίσεις Αναζήτησης Βοήθειας"


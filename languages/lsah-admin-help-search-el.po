msgstr "Δεν έχετε δικαιώματα πρόσβασης σε αυτή τη σελίδα."

#: lsah-admin-help-search.php:474 lsah-admin-help-search.php:542
msgid "Please enter a URL."
msgstr "Παρακαλώ εισάγετε ένα URL."

#: lsah-admin-help-search.php:478 lsah-admin-help-search.php:547
msgid "The URL must start with http:// or https://."
msgstr "Το URL πρέπει να αρχίζει με http:// ή https://."

#: lsah-admin-help-search.php:481 lsah-admin-help-search.php:554
msgid "Please enter a valid URL."
msgstr "Παρακαλώ, δώστε μια έγκυρη διεύθυνση URL."

#: lsah-admin-help-search.php:485

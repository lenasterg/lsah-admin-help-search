#. Plugin Name of the plugin
#: lsah-admin-help-search.php
msgid "LSAH Admin Help Search (Multisite)"
msgstr "LSAH Admin Help Search (Multisite)"

#. Description of the plugin
#: lsah-admin-help-search.php
msgid ""
"Adds a quick help search box in the admin menu. Configurable search URL, "
"logs all searches, fully multisite-compatible."
msgstr ""
"Προσθέτει ένα πλαίσιο αναζήτησης βοήθειας στο μενού διαχείρισης (admin "
"menu). Ρυθμιζόμενο URL αναζήτησης, καταγραφή των αναζητήσεων πλήρως συμβατό "
"με multisite."

#. Author of the plugin
#: lsah-admin-help-search.php
msgid "lenasterg"
msgstr "lenasterg"

#. translators: %s: Settings page URL
#: lsah-admin-help-search.php:112
msgid "Settings → Help Search"
msgstr "Ρυθμίσεις → Αναζήτηση Bοήθειας"

#. translators: %1$s: message text, %2$s: link
#: lsah-admin-help-search.php:115
msgid "LSAH: Please configure the Help Search Action URL in %1$s."
msgstr ""
"LSAH: Παρακαλούμε ρυθμίστε το Action URL της Αναζήτησης Βοήθειας στις "
"Ρυθμίσεις → Αναζήτηση Βοήθειας."


#. Plugin Name of the plugin
#: lsah-admin-help-search.php
msgid "LSAH Admin Help Search (Multisite)"
msgstr "LSAH Admin Help Search (Multisite)"

#. Description of the plugin
#: lsah-admin-help-search.php
msgid ""
"Adds a search field within the WordPress dashboard for instant access to "
"user manuals and logs queries to help administrators improve documentation. "
"Fully multisite compatible."
msgstr ""
"Προσθέτει ένα πεδίο αναζήτησης στον πίνακα ελέγχου του WordPress για άμεση "
"πρόσβαση σε εγχειρίδια χρήστη και καταγράφει ερωτήματα για να βοηθήσει τους "
"διαχειριστές να βελτιώσουν την τεκμηρίωση. Πλήρως συμβατό με multisite."

#. Author of the plugin
#: lsah-admin-help-search.php
msgid "lenasterg"
msgstr "lenasterg"

